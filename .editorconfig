root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Unreal C++ / C# use tab indentation (engine source convention)
[*.{h,cpp,hpp,inl,cs}]
indent_style = tab
indent_size = 4

[*.{ini,uproject,uplugin,json}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
